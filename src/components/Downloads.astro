---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="download-section" id="downloads">
  <div class="container">
    <div class="section-header">
      <span class="badge" style="margin-bottom: 0.75rem;">Free & Open Source</span>
      <h2>Download Ophira PDF for Windows</h2>
      <p>Choose the distribution that fits your workflow: standard installer or standalone zero-install portable.</p>
    </div>

    <div class="downloads-grid">
      <!-- Setup Installer Card -->
      <div class="card download-card popular-card">
        <div class="popular-badge">Recommended</div>
        <div class="download-card-header">
          <div class="dl-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4h-13.051M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.951"/>
            </svg>
          </div>
          <div>
            <h3 class="dl-title">Windows Setup</h3>
            <span class="dl-sub">Installer (.exe)</span>
          </div>
        </div>

        <p class="dl-description">
          Installs Ophira PDF onto your Windows system with desktop shortcut, start menu entry, and automatic file associations.
        </p>

        <ul class="dl-feature-list">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Windows 10 / 11 (64-bit)</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Clean uninstaller included</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Size: ~85.8 MB</span>
          </li>
        </ul>

        <a
          href="https://github.com/1abdullahr1/velox-desktop/releases/download/v1.2.1/Ophira.PDF.1.2.1.Setup.exe"
          class="btn btn-primary btn-block"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <span>Download Setup v1.2.1</span>
        </a>
      </div>

      <!-- Standalone Portable Card -->
      <div class="card download-card">
        <div class="download-card-header">
          <div class="dl-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <div>
            <h3 class="dl-title">Standalone Portable</h3>
            <span class="dl-sub">No Install (.exe)</span>
          </div>
        </div>

        <p class="dl-description">
          Single standalone executable. Run immediately from your USB flash drive, external drive, or Downloads folder with zero install footprint.
        </p>

        <ul class="dl-feature-list">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Zero installation or admin rights required</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>No registry or temporary files left behind</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Size: ~85.4 MB</span>
          </li>
        </ul>

        <a
          href="https://github.com/1abdullahr1/velox-desktop/releases/download/v1.2.1/Ophira.PDF.1.2.1.Portable.exe"
          class="btn btn-secondary btn-block"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <span>Download Portable v1.2.1</span>
        </a>
      </div>
    </div>

    <!-- GitHub Release Banner -->
    <div class="github-banner card">
      <div class="github-banner-content">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <div>
          <h4>Open Source & Verified Builds</h4>
          <p>Inspect all source code, release hashes, and automated GitHub Actions CI/CD workflows.</p>
        </div>
      </div>
      <a
        href="https://github.com/1abdullahr1/velox-desktop/releases/tag/v1.2.1"
        class="btn btn-secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        View Release on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .download-section {
    padding: 5rem 0;
  }

  .downloads-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto 3rem;
  }

  .download-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem 2rem;
  }

  .popular-card {
    border-color: var(--brand-start);
    box-shadow: 0 10px 30px -10px var(--brand-glow);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    right: 24px;
    background: var(--brand-gradient);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 12px;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .download-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .dl-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--shade);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-start);
  }

  .dl-title {
    font-size: 1.35rem;
    margin-bottom: 0.2rem;
  }

  .dl-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .dl-description {
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .dl-feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 2rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .dl-feature-list li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .dl-feature-list svg {
    color: #10B981;
    flex-shrink: 0;
  }

  .btn-block {
    width: 100%;
  }

  .github-banner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
  }

  .github-banner-content {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .github-banner-content h4 {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .github-banner-content p {
    font-size: 0.88rem;
  }

  @media (max-width: 768px) {
    .github-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
