---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero-section">
  <div class="container hero-content">
    <div class="badge-row">
      <span class="badge hero-badge">
        <span class="badge-dot"></span>
        <span>Ophira PDF v1.2.1 for Windows</span>
      </span>
      <span class="badge badge-accent">100% Offline & Free</span>
    </div>

    <h1 class="hero-title">
      The modern, lightning-fast PDF reader <br class="title-break" />
      designed for <span class="text-gradient">pure flow</span>.
    </h1>

    <p class="hero-subtitle">
      Say goodbye to sluggish enterprise PDF bloat. Ophira PDF gives you sub-second launch times,
      continuous background auto-saving to your original file, customizable eye-comfort themes,
      and instant close without nagging popups.
    </p>

    <div class="hero-cta-group">
      <a href="#downloads" class="btn btn-primary btn-lg">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4h-13.051M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.951"/>
        </svg>
        <span>Download for Windows</span>
      </a>

      <a href="#interactive-preview" class="btn btn-secondary btn-lg">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="10 8 16 12 10 16 10 8"></polygon>
        </svg>
        <span>Interactive Demo</span>
      </a>
    </div>

    <div class="hero-highlights">
      <div class="highlight-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Instant Auto-Save to Disk</span>
      </div>
      <div class="highlight-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Zero-Prompt Instant Close</span>
      </div>
      <div class="highlight-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Both Installer & Standalone Portable</span>
      </div>
      <div class="highlight-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>100% Local & Private</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 4.5rem 0 3.5rem;
    position: relative;
    text-align: center;
  }

  .hero-content {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-badge {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10B981;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
    font-weight: 800;
  }

  .text-gradient {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.6;
    max-width: 720px;
    margin-bottom: 2.5rem;
    color: var(--text-muted);
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-highlights {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .highlight-item svg {
    color: var(--brand-start);
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.35rem;
    }
    .title-break {
      display: none;
    }
    .hero-subtitle {
      font-size: 1.05rem;
    }
    .hero-highlights {
      gap: 1rem;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
