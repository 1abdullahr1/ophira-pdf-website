---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="mockup-section" id="interactive-preview">
  <div class="container">
    <div class="section-header">
      <span class="badge" style="margin-bottom: 0.75rem;">Interactive Desktop Preview</span>
      <h2>Experience the Ophira PDF Interface</h2>
      <p>Test the built-in toolbar, toggle auto-save, and explore live document editing in real time.</p>
    </div>

    <div class="app-window" id="appWindow">
      <!-- Window Titlebar -->
      <div class="window-titlebar">
        <div class="window-controls">
          <span class="win-btn win-close" title="Instant Close"></span>
          <span class="win-btn win-minimize"></span>
          <span class="win-btn win-maximize"></span>
        </div>
        <div class="window-title">
          <img src={`${baseUrl}/icon.png`} alt="Icon" width="16" height="16" style="border-radius: 3px;" />
          <span>Ophira PDF — Quarterly_Strategic_Brief.pdf</span>
        </div>
        <div class="window-actions">
          <span class="version-tag">v1.2.1</span>
        </div>
      </div>

      <!-- App Viewer Custom Toolbar -->
      <div class="viewer-toolbar">
        <div class="toolbar-left">
          <!-- Home Tab Button -->
          <button type="button" class="mockup-btn btn-home" id="mockupHomeBtn" title="Back to Home Recent Files">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Home</span>
          </button>

          <div class="toolbar-divider"></div>

          <!-- Save to File Button -->
          <button type="button" class="mockup-btn btn-save" id="mockupSaveBtn" title="Save changes directly to file (Ctrl+S)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span>Save to File</span>
          </button>

          <!-- Auto-Save Toggle -->
          <button type="button" class="mockup-btn btn-autosave active" id="mockupAutoSaveBtn" title="Toggle Auto Save">
            <span class="autosave-indicator"></span>
            <span id="autosaveText">Auto Save: ON</span>
          </button>

          <!-- Status Indicator -->
          <div class="save-status-badge saved" id="mockupStatus">
            <span class="status-pulse"></span>
            <span id="statusLabel">All changes saved</span>
          </div>
        </div>

        <div class="toolbar-right">
          <!-- Annotation Tools -->
          <div class="tools-group">
            <button type="button" class="tool-icon-btn active" title="Highlight Text">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m9 11-6 6v3h3l6-6m-3-3 7-7a2 2 0 0 1 3 0l1 1a2 2 0 0 1 0 3l-7 7m-4-4 4 4"></path>
              </svg>
            </button>
            <button type="button" class="tool-icon-btn" title="Freehand Ink Drawing">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
              </svg>
            </button>
            <button type="button" class="tool-icon-btn" title="Add Text Note">
              <span style="font-weight: 700; font-size: 14px;">T</span>
            </button>
          </div>

          <div class="toolbar-divider"></div>

          <!-- Page Nav -->
          <div class="page-controls">
            <span>Page <strong>1</strong> of 8</span>
          </div>
        </div>
      </div>

      <!-- Window Workspace Area -->
      <div class="mockup-workspace">
        <div class="mockup-sidebar">
          <div class="sidebar-header">Thumbnails</div>
          <div class="thumb-item active">
            <div class="thumb-preview">1</div>
            <span>Executive Summary</span>
          </div>
          <div class="thumb-item">
            <div class="thumb-preview">2</div>
            <span>Performance Metrics</span>
          </div>
          <div class="thumb-item">
            <div class="thumb-preview">3</div>
            <span>Roadmap & Goals</span>
          </div>
        </div>

        <div class="mockup-doc-area">
          <div class="doc-page">
            <div class="doc-header">
              <span class="doc-brand">OPHIRA RESEARCH GROUP</span>
              <span class="doc-date">SEPTEMBER 2026</span>
            </div>

            <h3 class="doc-title">Modern PDF Architecture: Speed, Simplicity & Offline Flow</h3>

            <p class="doc-paragraph">
              Traditional desktop PDF viewers have grown burdened with hundreds of megabytes of unnecessary cloud synchronization services, telemetry daemons, and disruptive prompt dialogs.
            </p>

            <div class="doc-highlight">
              <span class="highlight-text">
                "Ophira PDF redefines the desktop document experience by ensuring that every change persists instantly to disk with zero user friction and zero telemetry."
              </span>
            </div>

            <p class="doc-paragraph">
              Featuring customized color-scheme modes, interactive annotation pens, text highlights, and instant exit capabilities, the reader guarantees that users spend their time reading and editing without technical distraction.
            </p>

            <div class="interactive-doc-note">
              <div class="note-header">
                <strong>📝 Interactive Note Editor (Type to test live saving):</strong>
              </div>
              <input
                type="text"
                class="mockup-input"
                id="testInput"
                placeholder="Type here to trigger live Auto-Save status..."
                value="Reviewed and approved for quarterly deployment."
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Interactive Mockup Script
  const mockupSaveBtn = document.getElementById('mockupSaveBtn');
  const mockupAutoSaveBtn = document.getElementById('mockupAutoSaveBtn');
  const autosaveText = document.getElementById('autosaveText');
  const mockupStatus = document.getElementById('mockupStatus');
  const statusLabel = document.getElementById('statusLabel');
  const testInput = document.getElementById('testInput');

  let isAutoSaveOn = true;
  let saveTimeout: any = null;

  function triggerSave() {
    if (!mockupStatus || !statusLabel) return;

    mockupStatus.className = 'save-status-badge saving';
    statusLabel.textContent = 'Saving changes...';

    clearTimeout(saveTimeout);
    saveTimeout = setTimeout(() => {
      mockupStatus.className = 'save-status-badge saved';
      statusLabel.textContent = 'All changes saved';
    }, 600);
  }

  // Click Save button
  mockupSaveBtn?.addEventListener('click', () => {
    triggerSave();
  });

  // Toggle AutoSave
  mockupAutoSaveBtn?.addEventListener('click', () => {
    isAutoSaveOn = !isAutoSaveOn;
    if (isAutoSaveOn) {
      mockupAutoSaveBtn.classList.add('active');
      if (autosaveText) autosaveText.textContent = 'Auto Save: ON';
      triggerSave();
    } else {
      mockupAutoSaveBtn.classList.remove('active');
      if (autosaveText) autosaveText.textContent = 'Auto Save: OFF';
      if (mockupStatus && statusLabel) {
        mockupStatus.className = 'save-status-badge unsaved';
        statusLabel.textContent = 'Auto-save paused';
      }
    }
  });

  // Typing in test input
  testInput?.addEventListener('input', () => {
    if (isAutoSaveOn) {
      if (mockupStatus && statusLabel) {
        mockupStatus.className = 'save-status-badge unsaved';
        statusLabel.textContent = 'Unsaved changes...';
      }
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(() => {
        triggerSave();
      }, 700);
    } else {
      if (mockupStatus && statusLabel) {
        mockupStatus.className = 'save-status-badge unsaved';
        statusLabel.textContent = 'Unsaved changes (Auto-save OFF)';
      }
    }
  });
</script>

<style>
  .mockup-section {
    padding: 2.5rem 0 5rem;
  }

  .app-window {
    background: var(--bg-card);
    border: 1px solid var(--shade);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 25px 60px -15px var(--brand-glow), 0 10px 25px -5px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  /* Titlebar */
  .window-titlebar {
    background: var(--surface);
    border-bottom: 1px solid var(--border-subtle);
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    font-size: 0.85rem;
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .win-btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }

  .win-close { background-color: #FF5F56; }
  .win-minimize { background-color: #FFBD2E; }
  .win-maximize { background-color: #27C93F; }

  .window-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--text-main);
  }

  .version-tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--shade);
    color: var(--text-main);
  }

  /* Viewer Toolbar */
  .viewer-toolbar {
    background: var(--surface);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .toolbar-left, .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .toolbar-divider {
    width: 1px;
    height: 22px;
    background: var(--shade);
    margin: 0 0.2rem;
  }

  .mockup-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    border: 1px solid var(--shade);
    background: var(--bg-card);
    color: var(--text-main);
    transition: all 0.15s ease;
  }

  .mockup-btn:hover {
    background: var(--surface);
    border-color: var(--brand-start);
  }

  .btn-save {
    background: var(--brand-gradient);
    color: #FFFFFF;
    border: none;
  }

  .btn-save:hover {
    filter: brightness(1.1);
  }

  .btn-autosave.active {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.4);
    color: #065F46;
  }

  .autosave-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
  }

  /* Save Status Badge */
  .save-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .save-status-badge.saved {
    background: rgba(16, 185, 129, 0.1);
    color: #047857;
  }

  .save-status-badge.saving {
    background: rgba(59, 130, 246, 0.12);
    color: #1D4ED8;
  }

  .save-status-badge.unsaved {
    background: rgba(245, 158, 11, 0.12);
    color: #B45309;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .tools-group {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .tool-icon-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .tool-icon-btn:hover {
    background: var(--surface);
    color: var(--text-main);
  }

  .tool-icon-btn.active {
    background: var(--bg-card);
    border-color: var(--shade);
    color: var(--brand-start);
  }

  .page-controls {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  /* Workspace Area */
  .mockup-workspace {
    display: flex;
    height: 480px;
    background: var(--code-bg);
  }

  .mockup-sidebar {
    width: 190px;
    background: var(--surface);
    border-right: 1px solid var(--border-subtle);
    padding: 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sidebar-header {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .thumb-item {
    padding: 0.5rem;
    border-radius: 8px;
    border: 1px solid transparent;
    cursor: pointer;
    font-size: 0.78rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .thumb-item.active {
    background: var(--bg-card);
    border-color: var(--shade);
    color: var(--text-main);
    font-weight: 600;
  }

  .thumb-preview {
    height: 44px;
    background: var(--bg-card);
    border: 1px solid var(--shade);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .mockup-doc-area {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .doc-page {
    width: 100%;
    max-width: 600px;
    background: #FFFFFF;
    border-radius: 8px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    color: #1A1A24;
    border: 1px solid #E8E6F0;
  }

  .doc-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    font-weight: 700;
    color: #8C8A9E;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #F0EDF5;
    padding-bottom: 0.5rem;
  }

  .doc-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: #141324;
    line-height: 1.3;
  }

  .doc-paragraph {
    font-size: 0.92rem;
    line-height: 1.65;
    color: #4A485A;
    margin-bottom: 1.25rem;
  }

  .doc-highlight {
    background: #FFF8D9;
    border-left: 4px solid var(--accent);
    padding: 0.85rem 1rem;
    border-radius: 0 6px 6px 0;
    margin-bottom: 1.25rem;
    font-style: italic;
    color: #383424;
  }

  .interactive-doc-note {
    background: #F7F6FC;
    border: 1px dashed var(--shade);
    border-radius: 8px;
    padding: 1rem;
    margin-top: 1.5rem;
  }

  .note-header {
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .mockup-input {
    width: 100%;
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem;
    border: 1px solid var(--shade);
    border-radius: 6px;
    background: #FFFFFF;
    color: #141324;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .mockup-input:focus {
    border-color: var(--brand-start);
  }

  @media (max-width: 768px) {
    .mockup-sidebar {
      display: none;
    }
    .mockup-workspace {
      height: auto;
    }
    .doc-page {
      padding: 1.5rem;
    }
  }
</style>
