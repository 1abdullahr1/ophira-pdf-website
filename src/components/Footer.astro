---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand-col">
      <div class="footer-logo">
        <img src={`${baseUrl}/icon-indigo.svg`} alt="Ophira PDF" width="32" height="32" />
        <span>Ophira <strong>PDF</strong></span>
      </div>
      <p class="footer-tagline">
        The modern, blazing-fast desktop PDF reader and editor. Designed for flow, offline privacy, and zero bloat.
      </p>
      <div class="footer-theme-indicator">
        <span>Available Themes:</span>
        <span class="dot-ind" style="background: #3A34C4;" title="Indigo"></span>
        <span class="dot-ind" style="background: #0D3B36;" title="Emerald"></span>
        <span class="dot-ind" style="background: #1B2532;" title="Navy"></span>
        <span class="dot-ind" style="background: #CFE0F3;" title="Light"></span>
      </div>
    </div>

    <div class="footer-nav-col">
      <h5>Quick Links</h5>
      <ul>
        <li><a href="#features">Features</a></li>
        <li><a href="#interactive-preview">Live Demo</a></li>
        <li><a href="#themes">Theme Palettes</a></li>
        <li><a href="#comparison">Comparison</a></li>
        <li><a href="#downloads">Downloads</a></li>
      </ul>
    </div>

    <div class="footer-nav-col">
      <h5>Releases</h5>
      <ul>
        <li><a href="https://github.com/1abdullahr1/velox-desktop/releases/download/v1.2.1/Ophira.PDF.1.2.1.Setup.exe">Windows Setup (v1.2.1)</a></li>
        <li><a href="https://github.com/1abdullahr1/velox-desktop/releases/download/v1.2.1/Ophira.PDF.1.2.1.Portable.exe">Windows Portable (v1.2.1)</a></li>
        <li><a href="https://github.com/1abdullahr1/velox-desktop/releases/tag/v1.2.1" target="_blank" rel="noopener">Release Notes</a></li>
        <li><a href="https://github.com/1abdullahr1/velox-desktop" target="_blank" rel="noopener">GitHub Repository</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© 2026 Ophira PDF. Free and Open Source under the MIT License.</p>
    <a href="#" class="back-to-top" aria-label="Back to top">
      <span>Back to top</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border-subtle);
    padding: 4.5rem 0 2.5rem;
    margin-top: 3rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.85rem;
  }

  .footer-tagline {
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 360px;
    margin-bottom: 1.25rem;
  }

  .footer-theme-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .dot-ind {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .footer-nav-col h5 {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .footer-nav-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav-col a {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .footer-nav-col a:hover {
    color: var(--text-main);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .back-to-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .back-to-top:hover {
    color: var(--brand-start);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
