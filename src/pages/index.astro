---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import InteractiveMockup from '../components/InteractiveMockup.astro';
import Features from '../components/Features.astro';
import ThemeShowcase from '../components/ThemeShowcase.astro';
import Comparison from '../components/Comparison.astro';
import Downloads from '../components/Downloads.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Ophira PDF — Fast, Distraction-Free Desktop PDF Reader & Editor">
  <Header />
  <main id="main-content">
    <Hero />
    <InteractiveMockup />
    <Features />
    <ThemeShowcase />
    <Comparison />
    <Downloads />
    <FAQ />
  </main>
  <Footer />
</Layout>
